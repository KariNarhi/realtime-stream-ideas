{
  "name": "realtime-stream-ideas",
  "version": "1.0.0",
  "description": "A simple real-time streaming application using FeathersJS and Socket.io",
  "main": "src/app.ts",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.client.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "start": "npm run build && node src/app.ts",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:report": "vite preview --outDir .vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@feathersjs/errors": "^5.0.50",
    "@feathersjs/express": "^5.0.51",
    "@feathersjs/feathers": "^5.0.50",
    "@feathersjs/socketio": "^5.0.51",
    "moment": "^2.31.0"
  },
  "devDependencies": {
    "@feathersjs/client": "5.0.51",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@vitest/ui": "5.1.1",
    "bootstrap": "4.3.1",
    "jsdom": "^31.0.1",
    "socket.io-client": "^4.8.4",
    "typescript": "7.0.2",
    "vitest": "^5.1.1"
  }
}
